# 复制为 backend/.env，填写自己的数据库密码；IDEA 工作目录选择 backend。
# .env 是 properties 文件，profile 使用下面的标准 Spring 属性名。
spring.profiles.active=dev,mysql
PORT=3001
HOST=127.0.0.1
DATABASE_URL=jdbc:mysql://127.0.0.1:3306/zhiqi_platform?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&sslMode=DISABLED&allowPublicKeyRetrieval=true
DATABASE_USERNAME=zhiqi_app
DATABASE_PASSWORD=填写自己的数据库密码
ADMIN_PHONE=13800000000
ADMIN_PASSWORD=DevAdmin123!
ADMIN_NAME=平台管理员
SMS_MODE=console
SMS_SECRET=replace-with-a-long-random-secret-at-least-32-characters
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
PUBLIC_ORIGIN=http://localhost:5173
