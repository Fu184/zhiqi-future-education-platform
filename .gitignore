# 真实连接配置和密钥；示例配置必须提交
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks

# 本地数据库文件；建表 SQL 不忽略
/backend/data/
/data/
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite3
*.mv.db
*.trace.db
*.lock.db

# 截图、测试报告、临时文件和历史预览
