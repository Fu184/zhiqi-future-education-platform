# 源码统一 LF，Windows 启动脚本使用 CRLF
* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
.githooks/* text eol=lf
backend/mvnw text eol=lf

# 图片和二进制文件禁止换行转换
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.jar binary
*.zip binary
*.pdf binary
